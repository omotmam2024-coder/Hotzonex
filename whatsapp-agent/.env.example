# ── Claude ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# ── WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup) ─
WHATSAPP_TOKEN=EAAG...                # permanent System User access token
WHATSAPP_PHONE_NUMBER_ID=1234567890   # "Phone number ID", not the phone number
WHATSAPP_VERIFY_TOKEN=pick-any-random-string   # must match what you enter in the webhook config
WHATSAPP_APP_SECRET=abc123...         # App settings → Basic → App secret (used to verify signatures)
# WHATSAPP_API_VERSION=v21.0

# ── Owner / staff access ─────────────────────────────────────────────────────
# Comma-separated WhatsApp numbers (international format, digits only) that may
# view financials and record daily entries. Everyone else is treated as a customer.
OWNER_NUMBERS=211912345678
# Number that receives escalations from customers (defaults to the first owner number)
# ESCALATION_NUMBER=211912345678

# ── Supabase (same project as the dashboard) ─────────────────────────────────
SUPABASE_URL=https://prxumouufckubwioywuz.supabase.co
# Prefer the service-role key here: this runs server-side only, never in a browser.
SUPABASE_KEY=eyJ...

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=3000
BUSINESS_TIMEZONE=Africa/Juba
